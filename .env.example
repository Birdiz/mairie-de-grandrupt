# Copy to .env.local and fill in real values.

# ─── Resend (contact form) ───────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=communedegrandrupt@orange.fr
CONTACT_EMAIL_FROM=noreply@village-de-grandrupt.fr

# ─── Payload CMS ──────────────────────────────────────────────────────────────
# Long random string used to sign auth tokens. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# SQLite database location (libsql URL). Relative to the app working directory.
# In Docker this resolves to /app/data/payload.db (mounted as a volume).
DATABASE_URI=file:./data/payload.db

# ─── Déploiement (auto-hébergé) ──────────────────────────────────────────────
# Adresse canonique du site (avec le www), servie par Caddy qui obtient le
# certificat HTTPS automatiquement (Let's Encrypt).
# Laisser vide en local : Caddy sert https://localhost avec un certificat auto-signé.
SITE_DOMAIN=www.village-de-grandrupt.fr
# Domaine nu, redirigé en 301 vers SITE_DOMAIN. Les deux doivent avoir un
# enregistrement DNS A (et AAAA si IPv6) pointant vers le serveur.
SITE_DOMAIN_APEX=village-de-grandrupt.fr
# URL publique absolue (sitemap.xml, robots.txt). Lue au runtime : pas de
# préfixe NEXT_PUBLIC_, qui figerait la valeur au build de l'image Docker.
SITE_URL=https://www.village-de-grandrupt.fr
